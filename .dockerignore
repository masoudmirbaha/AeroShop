# Never send secrets into the build context (root and nested).
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!.env.example
!.env.production.example
*.pem
*.key
deploy/secrets/

# Installed / generated output is rebuilt inside the image
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo
apps/api/src/generated

# Runtime data
apps/api/storage/*
!apps/api/storage/.gitkeep

# Tooling / VCS
.git
.github
.vscode
.idea
**/*.log
**/.DS_Store
docker-compose*.yml
**/Dockerfile
