{
  "name": "aeroshop",
  "version": "0.3.0",
  "private": true,
  "description": "AeroShop - digital CFD products and engineering services",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @aeroshop/api db:generate",
    "db:migrate": "pnpm --filter @aeroshop/api db:migrate",
    "db:studio": "pnpm --filter @aeroshop/api db:studio",
    "db:seed": "pnpm --filter @aeroshop/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.4"
  }
}
