// AeroShop database schema.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum ProductType {
  SINGLE_PRODUCT
  BUNDLE
  COURSE
  FREE
}

enum ProductLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentProvider {
  MOCK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum ServiceRequestStatus {
  NEW
  REVIEWING
  QUOTED
  IN_PROGRESS
  DELIVERED
  CLOSED
}

enum ContentKind {
  PAGE
  POST
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens          RefreshToken[]
  cart                   Cart?
  orders                 Order[]
  enrollments            Enrollment[]
  downloadGrants         DownloadGrant[]
  reviews                Review[]
  serviceRequests        ServiceRequest[]
  serviceRequestMessages ServiceRequestMessage[]

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Topic {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id           String        @id @default(cuid())
  type         ProductType
  title        String
  slug         String        @unique
  summary      String
  description  String        @db.Text
  price        Decimal       @db.Decimal(12, 0)
  comparePrice Decimal?      @db.Decimal(12, 0)
  isDigital    Boolean       @default(true)
  level        ProductLevel?
  isPublished  Boolean       @default(false)
  isFeatured   Boolean       @default(false)
  categoryId   String?
  topicId      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  topic       Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  files       ProductFile[]
  bundleItems BundleItem[]    @relation("Bundle")
  includedIn  BundleItem[]    @relation("BundledProduct")
  sections    CourseSection[]
  enrollments Enrollment[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  @@index([categoryId])
  @@index([topicId])
  @@index([type])
  @@index([isPublished, isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  filename   String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  grants  DownloadGrant[]

  @@index([productId])
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  sortOrder Int    @default(0)

  bundle  Product @relation("Bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation("BundledProduct", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bundleId, productId])
  @@index([productId])
}

model CourseSection {
  id        String @id @default(cuid())
  productId String
  title     String
  sortOrder Int    @default(0)

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([productId])
}

model Lesson {
  id              String @id @default(cuid())
  sectionId       String
  title           String
  sortOrder       Int    @default(0)
  durationMinutes Int?

  section CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  subtotal  Decimal     @db.Decimal(12, 0)
  discount  Decimal     @default(0) @db.Decimal(12, 0)
  total     Decimal     @db.Decimal(12, 0)
  couponId  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  payment Payment?

  @@index([userId, createdAt])
  @@index([status])
  @@index([couponId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Decimal @db.Decimal(12, 0)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  grants  DownloadGrant[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id        String          @id @default(cuid())
  orderId   String          @unique
  provider  PaymentProvider @default(MOCK)
  status    PaymentStatus   @default(PENDING)
  amount    Decimal         @db.Decimal(12, 0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders Order[]
}

model DownloadGrant {
  id            String    @id @default(cuid())
  userId        String
  productFileId String
  orderItemId   String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  productFile ProductFile @relation(fields: [productFileId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, productFileId])
  @@index([orderItemId])
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]
}

model ServiceRequest {
  id           String               @id @default(cuid())
  userId       String
  serviceId    String
  status       ServiceRequestStatus @default(NEW)
  subject      String
  message      String               @db.Text
  quotedAmount Decimal?             @db.Decimal(12, 0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service     Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  messages    ServiceRequestMessage[]
  attachments Attachment[]

  @@index([userId])
  @@index([serviceId])
  @@index([status])
}

model ServiceRequestMessage {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User           @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([authorId])
}

model Attachment {
  id         String   @id @default(cuid())
  requestId  String
  filename   String
  storageKey String   @unique
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  body       String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId, isApproved])
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorTitle String?
  body        String   @db.Text
  rating      Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id          String      @id @default(cuid())
  kind        ContentKind @default(PAGE)
  title       String
  slug        String      @unique
  excerpt     String?
  content     String      @db.Text
  isPublished Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([kind, isPublished])
}
