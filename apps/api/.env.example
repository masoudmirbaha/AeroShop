NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

# PostgreSQL runs in Docker (docker-compose.yml) and is published on localhost:5432.
# USER, PASSWORD and DATABASE must match POSTGRES_* in the root .env
# (URL-encode special characters in the password).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/aeroshop"

# At least 16 characters. Replace these placeholders locally.
# With NODE_ENV=production the API refuses to start unless WEB_URL is set and both
# secrets are 32+ characters, distinct, and not these placeholders.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32

# Payments: `mock` (test buttons, development/test only) or `disabled` (paid checkout
# returns 503). Defaults to `mock` outside production and `disabled` in production;
# the API refuses to start with PAYMENT_MODE=mock and NODE_ENV=production.
# Free (zero-total) carts can be checked out in either mode.
PAYMENT_MODE=mock

# Used only by `pnpm db:seed`. Replace before seeding.
ADMIN_EMAIL=admin@aeroshop.local
ADMIN_PASSWORD=change-me-admin
