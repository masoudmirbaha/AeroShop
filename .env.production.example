# Used by docker-compose.prod.yml:
#   cp .env.production.example .env.production
# Replace every CHANGE_ME value. Never commit .env.production.

# PostgreSQL. Use a URL-safe password (e.g. `openssl rand -hex 32`);
# it is embedded in the api's DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aeroshop

# Public origin of the site (https in production). Used for API CORS.
WEB_URL=https://CHANGE_ME.example

# At least 32 characters each, different from each other (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# Loopback-only host port for the web container (SSH-tunnel checks).
# Public traffic goes through the nginx service on ports 80/443.
WEB_PORT=3000
